<!-- Contact Section -->
<section class="contact-section">
  <div class="container">
    <h2 class="contact-title">{{settings.contact_title}}</h2>
    <p class="contact-subtitle">{{settings.contact_subtitle}}</p>
    <div class="contact-grid">
      <div class="contact-card">
        <div class="contact-icon">
          {{#if settings.contact_icon_1}}
            <img src="{{settings.contact_icon_1}}" alt="Contact Option 1" class="contact-icon-image">
          {{/if}}
        </div>
        <div class="contact-text">
          <a href="/hc/en-us/requests/new" class="contact-link">
            {{settings.contact_option_1_text}}
          </a>
        </div>
      </div>
      <div class="contact-card">
        <div class="contact-icon">
          {{#if settings.contact_icon_2}}
            <img src="{{settings.contact_icon_2}}" alt="Contact Option 2" class="contact-icon-image">
          {{/if}}
        </div>
        <div class="contact-text">
          <a href="tel:{{settings.contact_option_2}}" class="contact-link">
            {{settings.contact_option_2}}
          </a>
        </div>
      </div>
      <div class="contact-card">
        <div class="contact-icon">
          {{#if settings.contact_icon_3}}
            <img src="{{settings.contact_icon_3}}" alt="Contact Option 3" class="contact-icon-image">
          {{/if}}
        </div>
        <div class="contact-text">
          <a href="mailto:{{settings.contact_option_3}}" class="contact-link">
            {{settings.contact_option_3}}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
