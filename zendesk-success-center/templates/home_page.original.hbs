<!-- Hero component -->
<section class="hero hero-image"{{#if settings.homepage_background_image}} style="background-image: url('{{settings.homepage_background_image}}');"{{/if}}>
    <div class="hero-inner">
      <h1 class="welcome-message" style="margin: 0; padding: 25px;">{{#if settings.homepage_welcome_message}}{{settings.homepage_welcome_message}}{{else}}{{help_center.name}}{{/if}}</h1>
      <form role="search" class="search-full" data-search="" data-instant="true" autocomplete="off" action="/hc/en-us/search" accept-charset="UTF-8" method="get" style="display: block;"><input name="utf8" type="hidden" value="✓" autocomplete="off"><input type="search" name="query" id="query" placeholder="Start typing your question..." autocomplete="off" aria-label="Search">
			</form>
      <span id="search_placeholder_text" data-value="Start typing your question..." style="display:none;"></span>
    </div>
</section>

<!--Categories-->
<div class="container">
    <section class="knowledge-base  tripe_column">
      <section class="custom-blocks blocks">
        {{! Featured Categories as Blocks }}
        <section class="categories blocks">
          <ul class="blocks-list">
            {{#each categories}}
              {{#if name}}
                {{#if ../settings.category_1_title}}
                  {{#is name ../settings.category_1_title}}
                    <li class="blocks-item">
                      <a href='{{url}}' class="blocks-item-link">
                        {{#if ../settings.category_image_1}}
                          <img src="{{../settings.category_image_1}}" alt="{{name}}" class="blocks-item-image">
                        {{/if}}
                        <span class="blocks-item-title">{{name}}</span>
                      </a>
                    </li>
                  {{/is}}
                {{/if}}
                {{#if ../settings.category_2_title}}
                  {{#is name ../settings.category_2_title}}
                    <li class="blocks-item">
                      <a href='{{url}}' class="blocks-item-link">
                        {{#if ../settings.category_image_2}}
                          <img src="{{../settings.category_image_2}}" alt="{{name}}" class="blocks-item-image">
                        {{/if}}
                        <span class="blocks-item-title">{{name}}</span>
                        <span class="blocks-item-description">{{excerpt description}}</span>
                      </a>
                    </li>
                  {{/is}}
                {{/if}}
                {{#if ../settings.category_3_title}}
                  {{#is name ../settings.category_3_title}}
                    <li class="blocks-item">
                      <a href='{{url}}' class="blocks-item-link">
                        {{#if ../settings.category_image_3}}
                          <img src="{{../settings.category_image_3}}" alt="{{name}}" class="blocks-item-image">
                        {{/if}}
                        <span class="blocks-item-title">{{name}}</span>
                        <span class="blocks-item-description">{{excerpt description}}</span>
                      </a>
                    </li>
                  {{/is}}
                {{/if}}
                {{#if ../settings.category_4_title}}
                  {{#is name ../settings.category_4_title}}
                    <li class="blocks-item">
                      <a href='{{url}}' class="blocks-item-link">
                        {{#if ../settings.category_image_4}}
                          <img src="{{../settings.category_image_4}}" alt="{{name}}" class="blocks-item-image">
                        {{/if}}
                        <span class="blocks-item-title">{{name}}</span>
                        <span class="blocks-item-description">{{excerpt description}}</span>
                      </a>
                    </li>
                  {{/is}}
                {{/if}}
              {{/if}}
            {{/each}}
          </ul>
        </section>
      </section>
    </section>
  </div>

